# ─────────────────────────────────────────────────────────────────────────────
# coworks 환경변수 템플릿
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env 는 .gitignore 대상이다. 실제 키는 .env 에만 넣고 절대 커밋하지 않는다.
# 셸에 이미 같은 이름의 환경변수가 있으면 그 값이 우선한다(.env 가 덮어쓰지 않음).
# 값에 공백이나 #이 들어가면 "큰따옴표"로 감싼다.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenRouter (openrouter-live-chat.js, openrouter-chat.js) ─────────────────

# 필수. https://openrouter.ai/keys 에서 발급. 형식: sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 모델 id. 기본값 stealth/ox-alpha (1M 컨텍스트, 현재 무료, reasoning 필수 모델)
# 다른 id는 실행 후 /models <검색어> 로 찾을 수 있다.
#OPENROUTER_MODEL=stealth/ox-alpha

# reasoning effort. ox-alpha 지원값: low | high | max (미지정 시 모델 기본값 max)
# 높을수록 품질↑ 지연·완료토큰↑.
#OPENROUTER_EFFORT=high

# 시스템 프롬프트. 미지정 시 "한국어로 답하는 코딩 어시스턴트" 기본값을 쓴다.
#OPENROUTER_SYSTEM="너는 coworks CLI에서 동작하는 코딩 어시스턴트다. 별도 요청이 없으면 한국어로 답한다."

# 1회 호출 타임아웃(초). 기본 300. reasoning=max 는 오래 걸릴 수 있다.
#OPENROUTER_TIMEOUT=300

# 파일 도구가 접근할 디렉터리(--cwd 로도 지정). 미지정 시 스크립트 폴더.
# 이 경로 밖과 .env 등 자격증명 파일은 도구가 거부한다.
#OPENROUTER_CHAT_CWD=D:\git\my-repo

# API 베이스 URL. 프록시/게이트웨이를 경유할 때만 바꾼다.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter 순위표에 표시되는 출처 헤더(선택). 없어도 동작한다.
#OPENROUTER_SITE_NAME=coworks
#OPENROUTER_SITE_URL=https://github.com/zaruous/coworks

# ── Cursor (cursor-live-chat.js, cursor-chat.js, scenario-review/*) ──────────

# 필수(Cursor 러너를 쓸 때). https://cursor.com/dashboard 에서 발급. 형식: key_...
#CURSOR_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cursor 에이전트가 파일을 읽고 명령을 실행할 디렉터리. 기본값은 스크립트 폴더.
#CURSOR_CHAT_CWD=D:\git\my-repo

# ── Claude (claude-live-chat.js) — CLI 로그인 사용, API 키 불필요 ────────────

# 모델 id. 기본 sonnet
#CLAUDE_MODEL=sonnet

# 에이전트 작업 디렉터리. 기본값은 스크립트 폴더.
#CLAUDE_CHAT_CWD=D:\git\my-repo

# 권한 모드. 기본 dontAsk (구현 위임 시에는 acceptEdits 권장)
#CLAUDE_PERMISSION_MODE=dontAsk

# ── Codex (codex-live-chat.js) — ChatGPT 계정 로그인 사용 ────────────────────
# 러너가 CODEX_API_KEY / OPENAI_API_KEY 를 실행 환경에서 제거하므로 여기에 넣지 말 것.

# 모델 id. 미지정 시 Codex CLI 기본값.
#CODEX_MODEL=gpt-5-codex

# ── agy / Antigravity CLI (agy-live-chat.js) — CLI 로그인 사용, API 키 불필요 ─

# agy 실행 파일 경로. PATH 에 있으면 지정할 필요 없다.
#AGY_BIN=C:\Users\<사용자>\AppData\Local\agy\bin\agy.exe

# 모델 id. 미지정 시 CLI 기본값. 목록은 `agy models` 또는 대화 중 /models
#AGY_MODEL=gemini-3.1-pro-high

# reasoning effort: low | medium | high. 미지정 시 모델 기본값
#AGY_EFFORT=high

# 실행 모드: plan | accept-edits
#AGY_MODE=plan

# 에이전트 작업 디렉터리(워크스페이스에도 자동 추가). 기본값은 스크립트 폴더.
#AGY_CHAT_CWD=D:\git\my-repo

# 한 턴 제한(초). 기본 600
#AGY_TIMEOUT=600

# 1 이면 셸 명령까지 자동 승인(--yolo 와 동일). 기본은 꺼짐 — 명령이 필요할 때만 켠다.
#AGY_SKIP_PERMISSIONS=1

# ── scenario-review ─────────────────────────────────────────────────────────

# 리뷰 대상 저장소(필수). --cwd 로도 지정 가능.
#REVIEW_TARGET_CWD=D:\git\my-repo

# 리뷰 로그 경로. 기본 <대상>/docs/plan/cursor-review-log.md
#REVIEW_LOG_PATH=D:\git\my-repo\docs\plan\cursor-review-log.md
